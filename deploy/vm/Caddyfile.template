{
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32
	}
}

# Any Host header (tailscale serve forwards the *.ts.net name), bound to loopback only: `tailscale serve` terminates TLS on the tailnet and forwards here.
http://:8080 {
	bind 127.0.0.1
	encode gzip

	@blocked {
		path /internal/* /v1/connector/* /v1/hosts/enrollment-codes /v1/hosts/ws /v1/hosts/redeem /v1/push/* /v1/talk/* /v1/pairing/redeem /v1/device/register /v1/hosts/current/revoke /docs /redoc /openapi.json
	}
	handle @blocked {
		respond 404
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		respond 404
	}
}

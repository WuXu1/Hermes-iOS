# Always-on Hermes dashboard API on loopback, used by the iPhone app's connector.
[Unit]
Description=Hermes dashboard API (loopback)
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/data/workspace
EnvironmentFile=/etc/hermes-mobile/dashboard.env
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/data/.hermes
Environment=PATH=/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hermes/.local/bin/hermes dashboard --host 127.0.0.1 --port 9119 --no-open --skip-build
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
